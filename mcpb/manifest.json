{
  "manifest_version": "0.4",
  "name": "vmware-pilot",
  "display_name": "VMware Pilot",
  "version": "2.5.1",
  "description": "VMware workflow orchestration — multi-step state machine with approval gates",
  "long_description": "Runs the published vmware-pilot 2.5.1 MCP server locally. This extension starts with read-only tools (expose = read); set it to all to offer write tools, which stay governed by the shared policy and are recorded in the local audit log. Follow the setup guide for local state and the sibling skills it uses.",
  "author": {
    "name": "Wei Zhou",
    "url": "https://github.com/zw008"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vmware-skills/VMware-Pilot"
  },
  "homepage": "https://github.com/vmware-skills/VMware-Pilot",
  "documentation": "https://github.com/vmware-skills/VMware-Pilot/blob/main/skills/vmware-pilot/references/setup-guide.md",
  "support": "https://github.com/vmware-skills/VMware-Pilot/issues",
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "server/main.py"
      ],
      "env": {
        "VMWARE_PILOT_MCP_EXPOSE": "${user_config.expose}"
      }
    }
  },
  "user_config": {
    "expose": {
      "type": "string",
      "title": "Tools to offer",
      "description": "read = read-only tools only (default); all = every tool, including writes.",
      "required": true,
      "default": "read"
    }
  },
  "tools_generated": true,
  "keywords": [
    "vmware",
    "vsphere",
    "workflow",
    "orchestration",
    "approval"
  ],
  "license": "MIT",
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
